# 复制本文件为 .env 并填写；.env 已在 .gitignore 中，不会被提交。
# 命令行参数优先于此处的配置。

# 上海科技大学统一身份认证账号（学号@密码），启动时自动登录获取 GenAI token
GENAI_ACCOUNT=

# 直接配置 GenAI token（优先于自动登录与缓存 token）
GENAI_TOKEN=

# 图片上传接口的 token 请求头（可选，默认内置当前可用值）
GENAI_UPLOAD_TOKEN=

# 固定上游会话分组 ID：所有 API 请求归入网页版同一条会话，避免会话列表刷屏（可选）
GENAI_CHAT_GROUP_ID=

# 服务监听端口（可选，默认 11435）
GENAI_PORT=

# 服务监听地址（可选，默认 127.0.0.1；局域网/反向代理场景设 0.0.0.0）
GENAI_HOST=

# 代理自身的 API 鉴权密钥（可选；设置后 /v1/* 需携带 Authorization: Bearer <key>，
# 通过 frp 等暴露到本机以外时强烈建议设置）
GENAI_API_KEY=
