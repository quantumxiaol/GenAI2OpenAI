# 复制本文件为 .env 并填写；.env 已在 .gitignore 中，不会被提交。
# 命令行参数优先于此处的配置。

# 上海科技大学统一身份认证账号（学号@密码），启动时自动登录获取 GenAI token
GENAI_ACCOUNT=

# 直接配置 GenAI token（优先于自动登录与缓存 token）
GENAI_TOKEN=

# 图片上传接口的 token 请求头（可选，默认内置当前可用值）
GENAI_UPLOAD_TOKEN=

# 固定上游会话分组 ID：所有 API 请求归入网页版同一条会话，避免会话列表刷屏（可选）
GENAI_CHAT_GROUP_ID=

# 服务监听端口（可选，默认 11435）
GENAI_PORT=

# 服务监听地址（可选，默认 127.0.0.1；局域网/反向代理场景设 0.0.0.0）
GENAI_HOST=

# 禁用 GPT/Azure 路由模型（设为 1 启用）：/v1/models 不再列出 GPT 系，
# 相关对话与图像生成请求直接报错，避免误用 Azure 额度（默认不启用）
GENAI_DISABLE_AZURE=

# 学校域名强制直连（默认开启，绕过本机代理客户端）。仅当在校外通过学校 VPN 的
# HTTP 代理形态或校园网出口节点访问时才需要设为 0（EasyConnect 等路由层 VPN 无需设置）
GENAI_SCHOOL_DIRECT=

# 代理自身的 API 鉴权密钥（可选；设置后 /v1/* 需携带 Authorization: Bearer <key>，
# 通过 frp 等暴露到本机以外时强烈建议设置）
GENAI_API_KEY=

# 客户端测试工具（smoke/benchmark/test_tool_call）默认打这个地址；
# 测本机保持默认，测 frp 穿透的服务改成对应地址（带不带 /v1 均可）
GENAI_API_BASE_URL=http://127.0.0.1:11435/v1
